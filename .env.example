# Database (Prisma Postgres on Vercel)
prisma_main_DATABASE_URL="postgresql://user:password@host:5432/db?schema=public"

# Redis (Upstash on Vercel)
redis_v1_REDIS_URL="redis://default:password@host:6379"

# Auth
AUTH_SECRET="generate-a-secure-random-string-here"
NEXTAUTH_URL="http://localhost:3000"

# App
NODE_ENV="development"
